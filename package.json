{
  "name": "agent-workflow",
  "private": true,
  "version": "0.1.0",
  "description": "Agent Workflow — local AI development workflow desktop app",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --import tsx --watch packages/server/src/main.ts",
    "dev:web": "npm run dev --workspace @agent-workflow/web",
    "start": "node --import tsx packages/server/src/main.ts",
    "desktop": "npm run build && electron .build/desktop/main.mjs",
    "build": "npm run typecheck && npm run build:mcp && npm run build:web && npm run build:server && npm run build:desktop",
    "build:web": "npm run build --workspace @agent-workflow/web",
    "build:server": "node scripts/build-server.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs packages/shared packages/storage packages/git packages/database packages/mcp packages/opencode",
    "test:integration": "node scripts/test.mjs tests",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:model": "node --import tsx scripts/model-smoke.mjs",
    "verify": "npm run typecheck && npm run test",
    "clean": "rm -rf .build dist apps/web/dist",
    "build:mcp": "node scripts/build-mcp.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "eventsource-parser": "3.1.1",
    "fastify": "5.6.2",
    "mysql2": "3.24.6",
    "pg": "^8.16.3",
    "pptxgenjs": "^3.12.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.1",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  },
  "main": ".build/desktop/main.mjs",
  "author": "Agent Workflow"
}
